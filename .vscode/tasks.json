{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "compile-tests",
            "type": "shell",
            "command": "mvn",
            "args": ["test-compile"],
            "group": "build",
            "presentation": {
                "echo": true,
                "reveal": "silent",
                "focus": false,
                "panel": "shared"
            },
            "problemMatcher": "$java"
        },
        {
            "label": "mvn test",
            "type": "shell", 
            "command": "mvn",
            "args": ["test"],
            "group": "test",
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared"
            },
            "problemMatcher": "$java"
        }
    ]
}